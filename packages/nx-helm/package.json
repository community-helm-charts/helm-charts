{
  "name": "@community-helm-charts/nx-helm",
  "version": "0.0.0",
  "private": true,
  "description": "Nx plugin for discovering and orchestrating Helm chart workspaces.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./release": {
      "types": "./dist/release.d.cts",
      "require": "./dist/release.cjs",
      "default": "./dist/release.cjs"
    },
    "./executors.json": "./executors.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "executors": "./executors.json",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "nx",
    "helm",
    "helm-chart",
    "kubernetes"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "nx": "^22.7.5"
  },
  "dependencies": {
    "@nx/devkit": "^22.7.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
